{
  "framework": "create-react-app",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://vsbh-cl-backend.onrender.com/api/:match*"
    },
    {
      "source": "/socket.io/:match*",
      "destination": "https://vsbh-cl-backend.onrender.com/socket.io/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
