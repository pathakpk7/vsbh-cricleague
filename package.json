{
  "name": "vsbh-cl",
  "version": "1.0.0",
  "description": "VSBH Cricket League Management System",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest server/tests/health.test.js --passWithNoTests",
    "lint": "eslint server/ --ext .js",
    "lint:fix": "eslint server/ --ext .js --fix",
    "docker:build": "docker build -t vsbh-cl .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "logs": "docker-compose logs -f"
  },
  "keywords": [
    "cricket",
    "league",
    "auction",
    "management",
    "react",
    "node",
    "socket.io"
  ],
  "author": "Prasoon Pathak",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "concurrently": "^7.6.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  },
  "dependencies": {
    "winston": "^3.11.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/client/src/setupTests.js"
    ],
    "testMatch": [
      "<rootDir>/server/tests/**/*.test.js",
      "<rootDir>/client/src/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "server/**/*.js",
      "client/src/**/*.{js,jsx,ts,tsx}",
      "!client/src/index.js",
      "!client/src/reportWebVitals.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
